# ==============================================================================
# CyberShield AI 2.0 — Environment Configuration Example (.env.example)
# Copy this file to .env and customize values for your local environment.
# NEVER commit actual secret keys or credentials to version control.
# ==============================================================================

# Core Application Settings
APP_NAME="CyberShield AI 2.0"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=false

# Server Network Binding
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Logging & Observability (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Application Internal Secret Key (Change to a 32+ character random string in production)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-production"

# ------------------------------------------------------------------------------
# Subsystem Placeholders (Phase 03: AI Integration)
# ------------------------------------------------------------------------------
# Google Gemini API Key for semantic phishing & social engineering analysis
# Keep blank during local heuristic testing. Set when enabling AI features.
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-1.5-flash"
AI_ANALYSIS_ENABLED=true

# ------------------------------------------------------------------------------
# Subsystem Placeholders (Phase 04: Blockchain & Trust Integration)
# ------------------------------------------------------------------------------
# Web3 Provider JSON-RPC URL (e.g. Infura, Alchemy, or local Anvil/Hardhat node)
# Example: https://eth-mainnet.g.alchemy.com/v2/YOUR-KEY
WEB3_PROVIDER_URI=""
BLOCKCHAIN_VERIFICATION_ENABLED=false

# ------------------------------------------------------------------------------
# Threat Engine Settings (Phase 02: Core Security Engine)
# ------------------------------------------------------------------------------
MAX_REDIRECTS=5
REQUEST_TIMEOUT_SECONDS=5.0
