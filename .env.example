# ==============================================================================
# CyberShield AI 2.0 — Local Environment Configuration Template (.env.example)
# Copy this file to .env in your root directory.
# NEVER commit actual API keys, secrets, or credentials to version control.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini Threat Intelligence API
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10.0
GEMINI_MAX_RETRIES=2

# VirusTotal Threat Intelligence API
VIRUSTOTAL_API_KEY=""

# Google Safe Browsing API
GOOGLE_SAFE_BROWSING_API_KEY=""

# Security Shields & Privacy Controls
ENABLE_PROMPT_INJECTION_SHIELD=true
ENABLE_PII_REDACTION=true
ENFORCE_ZERO_TRUST_VALIDATION=true

# Static File Inspection Resource Boundaries
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
MAX_ARCHIVE_FILE_COUNT=500
MAX_ARCHIVE_COMPRESSION_RATIO=100.0

# Database Persistence
DATABASE_URL="sqlite:///backend/cybershield.db"

# Blockchain Web3 Trust Subsystem
WEB3_PROVIDER_URI=""
BLOCKCHAIN_CONTRACT_ADDRESS=""
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_VERIFICATION_ENABLED=false
BLOCKCHAIN_SIMULATION_MODE=false
